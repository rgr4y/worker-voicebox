{
	"info": {
		"name": "RunPod + Voicebox",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "runpod_api_key", "value": "", "type": "string"},
		{"key": "endpoint_id", "value": "fwwoczl5gzpx6s", "type": "string"},
		{"key": "worker_id", "value": "", "type": "string"},
		{"key": "worker_host", "value": "", "type": "string"},
		{"key": "worker_port", "value": "17493", "type": "string"},
		{"key": "job_id", "value": "", "type": "string"}
	],
	"auth": {
		"type": "apikey",
		"apikey": [
			{"key": "key", "value": "Authorization"},
			{"key": "value", "value": "Bearer {{runpod_api_key}}"}
		]
	},
	"item": [
		{
			"name": "RunPod Discovery",
			"item": [
				{
					"name": "All Endpoints + Workers + Ports",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"{ myself { endpoints { id name workersMin workersMax gpuCount pods { id runtime { ports { ip isIpPublic privatePort publicPort type } } } } } }\"}"
						}
					},
					"description": "One query to find all endpoints, their running workers, and port mappings"
				},
				{
					"name": "Get Endpoint Full Config",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"query getEndpointFull($id: String!) { myself { endpoint(id: $id) { id name flashBootType executionTimeoutMs gpuIds idleTimeout locations networkVolumeId env { key value } pods { id runtime { ports { ip isIpPublic privatePort publicPort type } } } templateId workersMin workersMax } } }\",\"variables\":{\"id\":\"{{endpoint_id}}\"}}"
						}
					},
					"description": "Full endpoint config including env vars, GPU types, timeouts, network volumes"
				},
				{
					"name": "Get All Endpoints Config",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"{ myself { endpoints { id name flashBootType gpuIds idleTimeout locations networkVolumeId env { key value } templateId workersMin workersMax type } } }\"}"
						}
					}
				},
				{
					"name": "Get Worker Ports (by ID)",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"{ pod(input: { podId: \\\"{{worker_id}}\\\" }) { id runtime { ports { ip isIpPublic privatePort publicPort type } } } }\"}"
						}
					}
				},
				{
					"name": "Get Worker Details (hapi - browser token)",
					"request": {
						"method": "GET",
						"url": "https://hapi.runpod.net/v1/pod/{{worker_id}}",
						"header": [{"key": "Authorization", "value": "Bearer {{runpod_session_token}}"}],
						"description": "Uses Clerk JWT session token from browser devtools, not rpa_ API key. Returns GPU stats, disk usage, memory, process count."
					}
				},
				{
					"name": "List All Pods",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"{ myself { pods { id name desiredStatus imageName machine { gpuDisplayName } runtime { ports { ip isIpPublic privatePort publicPort type } } } } }\"}"
						}
					}
				}
			]
		},
		{
			"name": "RunPod Billing & Metrics",
			"item": [
				{
					"name": "Account Balance",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"{ myself { id email clientBalance currentSpendPerHr } }\"}"
						}
					}
				},
				{
					"name": "Serverless Billing",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"query getUserBillingServerless($input: UserBillingInput!, $serverlessInput: UserServerlessBillingInput) { myself { billing(input: $input) { serverless(input: $serverlessInput) { amount endpointId gpuTypeId time timeBilledSeconds instanceId } } } }\",\"variables\":{\"input\":{\"startDate\":\"2026-04-01\",\"endDate\":\"2026-04-30\"},\"serverlessInput\":{}}}"
						}
					}
				},
				{
					"name": "Endpoint Metrics",
					"request": {
						"method": "GET",
						"url": "https://api.runpod.ai/v1/{{endpoint_id}}/metrics",
						"header": [{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}]
					}
				},
				{
					"name": "Endpoint Request Time Series",
					"request": {
						"method": "GET",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/metrics/request_ts_v1",
						"header": [{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}]
					}
				},
				{
					"name": "List Endpoint Requests",
					"request": {
						"method": "GET",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/requests",
						"header": [{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}]
					}
				},
				{
					"name": "GPU Types & Pricing",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.io/graphql?api_key={{runpod_api_key}}",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"query\":\"{ gpuTypes { id displayName memoryInGb securePrice communityPrice lowestPrice(input: { gpuCount: 1, secureCloud: true }) { stockStatus minimumBidPrice uninterruptablePrice } } }\"}"
						}
					}
				}
			]
		},
		{
			"name": "RunPod Serverless Jobs",
			"item": [
				{
					"name": "Run Sync - Health Check",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/runsync",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"input\": {\n    \"path\": \"/health\",\n    \"method\": \"GET\"\n  }\n}"
						}
					},
					"description": "Response includes workerId — use it with 'Get Worker Ports' to find direct TCP access"
				},
				{
					"name": "Run Sync - List Profiles",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/runsync",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"input\": {\n    \"path\": \"/profiles\",\n    \"method\": \"GET\"\n  }\n}"
						}
					}
				},
				{
					"name": "Run Sync - Generate Speech",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/runsync",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"input\": {\n    \"path\": \"/generate\",\n    \"method\": \"POST\",\n    \"body\": {\n      \"profile_id\": \"YOUR_PROFILE_ID\",\n      \"text\": \"Hello world\"\n    }\n  }\n}"
						}
					}
				},
				{
					"name": "Run Sync - Download Model",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/runsync",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"input\": {\n    \"path\": \"/models/download\",\n    \"method\": \"POST\",\n    \"body\": {\n      \"model_name\": \"qwen-tts-1.7B\"\n    }\n  }\n}"
						}
					}
				},
				{
					"name": "Run Sync - Load Model",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/runsync",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"input\": {\n    \"path\": \"/models/load\",\n    \"method\": \"POST\",\n    \"params\": {\n      \"model_size\": \"1.7B\"\n    }\n  }\n}"
						}
					}
				},
				{
					"name": "Run Async",
					"request": {
						"method": "POST",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/run",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"input\": {\n    \"path\": \"/generate\",\n    \"method\": \"POST\",\n    \"body\": {\n      \"profile_id\": \"YOUR_PROFILE_ID\",\n      \"text\": \"Hello world\"\n    }\n  }\n}"
						}
					},
					"description": "Returns job ID immediately. Poll status with Check Job Status."
				},
				{
					"name": "Check Job Status",
					"request": {
						"method": "GET",
						"url": "https://api.runpod.ai/v2/{{endpoint_id}}/status/{{job_id}}",
						"header": [
							{"key": "Authorization", "value": "Bearer {{runpod_api_key}}"}
						]
					}
				}
			]
		},
		{
			"name": "Direct Worker API",
			"item": [
				{
					"name": "Health",
					"request": {
						"method": "GET",
						"url": "http://{{worker_host}}:{{worker_port}}/health"
					}
				},
				{
					"name": "List Profiles",
					"request": {
						"method": "GET",
						"url": "http://{{worker_host}}:{{worker_port}}/profiles"
					}
				},
				{
					"name": "Generate Speech",
					"request": {
						"method": "POST",
						"url": "http://{{worker_host}}:{{worker_port}}/generate",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"profile_id\": \"YOUR_PROFILE_ID\",\n  \"text\": \"Hello world\"\n}"
						}
					}
				},
				{
					"name": "Load Model",
					"request": {
						"method": "POST",
						"url": "http://{{worker_host}}:{{worker_port}}/models/load?model_size=1.7B"
					}
				},
				{
					"name": "Download TTS Model",
					"request": {
						"method": "POST",
						"url": "http://{{worker_host}}:{{worker_port}}/models/download",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model_name\": \"qwen-tts-1.7B\"\n}"
						}
					}
				},
				{
					"name": "Download Whisper (large-v3-turbo)",
					"request": {
						"method": "POST",
						"url": "http://{{worker_host}}:{{worker_port}}/models/download",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model_name\": \"whisper-large-v3-turbo\"\n}"
						}
					}
				},
				{
					"name": "Download Whisper (base)",
					"request": {
						"method": "POST",
						"url": "http://{{worker_host}}:{{worker_port}}/models/download",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model_name\": \"whisper-base\"\n}"
						}
					}
				},
				{
					"name": "Proxy Status",
					"request": {
						"method": "GET",
						"url": "http://{{worker_host}}:{{worker_port}}/_proxy/status"
					}
				},
				{
					"name": "Proxy Start Backend",
					"request": {
						"method": "GET",
						"url": "http://{{worker_host}}:{{worker_port}}/_proxy/start"
					}
				},
				{
					"name": "Proxy Stop Backend",
					"request": {
						"method": "GET",
						"url": "http://{{worker_host}}:{{worker_port}}/_proxy/stop"
					}
				},
				{
					"name": "Proxy Restart Backend",
					"request": {
						"method": "GET",
						"url": "http://{{worker_host}}:{{worker_port}}/_proxy/restart"
					}
				}
			]
		}
	]
}
